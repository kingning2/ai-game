{
  "name": "agent-packages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:rs": "cargo clippy --manifest-path rust/Cargo.toml --workspace -- -D warnings",
    "format": "oxfmt .",
    "format:rs": "cargo fmt --manifest-path rust/Cargo.toml --all",
    "typecheck": "turbo run typecheck",
    "dev:win": "pnpm --filter @agent-packages/desktop tauri dev",
    "dev": "pnpm --filter @agent-packages/web dev",
    "server": "cargo run -p server --manifest-path rust/Cargo.toml",
    "server:watch": "cd rust && watchexec -r -- cargo run -p server"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.5.10",
    "typescript": "catalog:"
  }
}
